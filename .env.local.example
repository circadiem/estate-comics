# Copy this file to .env.local and fill in your keys.
# Never commit .env.local to version control.

# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# GoCollect Valuation API
GOCOLLECT_API_KEY=

# Resend Transactional Email
RESEND_API_KEY=re_...

# Supabase (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# File Storage (S3 or Cloudflare R2)
S3_BUCKET_NAME=thecomicbuyers-uploads
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Transactional email addresses — REQUIRED, no in-code fallback.
# FROM_EMAIL is the verified Resend sender; INTAKE_EMAIL receives the internal
# notification for every submission.
FROM_EMAIL="Estate Comics <noreply@estatecomics.com>"
INTAKE_EMAIL=intake@estatecomics.com

# Public site URL (used for QR codes and links in PDF reports)
NEXT_PUBLIC_SITE_URL=https://thecomicbuyers.com
