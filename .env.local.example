# Copy this file to .env.local and fill in your keys.
# Never commit .env.local to version control.

# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# GoCollect Valuation API
GOCOLLECT_API_KEY=

# Resend Transactional Email
RESEND_API_KEY=re_...

# Supabase (PostgreSQL) — SERVER ONLY.
# SUPABASE_SERVICE_ROLE_KEY is the service_role key from Project Settings → API.
# It bypasses row-level security. It is read only by lib/services/supabase.ts on
# the server and must never appear in client code, NEXT_PUBLIC_* vars, or git.
# Apply supabase/migrations/*.sql before the first submission.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (photo storage) — SERVER ONLY. Optional: when unset, the
# appraisal pipeline sends photos inline and no photo is stored anywhere.
# Bucket: estatecomics-uploads. Keys: uploads/{session}/{image}.jpg (+ .thumb.jpg)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=estatecomics-uploads

# Upstash Redis — REQUIRED WHENEVER R2 IS SET.
# /api/upload is the only unauthenticated write path to object storage, so it
# refuses every request unless a rate limiter is available. Setting the R2 keys
# without these will make uploads return 503 and the appraisal will silently
# fall back to sending photos inline (nothing is stored).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Transactional email addresses — REQUIRED, no in-code fallback.
# FROM_EMAIL is the verified Resend sender; INTAKE_EMAIL receives the internal
# notification for every submission.
FROM_EMAIL="Estate Comics <noreply@estatecomics.com>"
INTAKE_EMAIL=intake@estatecomics.com

# Public site URL (used for QR codes and links in PDF reports)
NEXT_PUBLIC_SITE_URL=https://thecomicbuyers.com
